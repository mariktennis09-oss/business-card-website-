# Строка подключения, которую использует приложение в рантайме.
# На Vercel/Neon это POOLED endpoint (с ?pgbouncer=true&connection_limit=1).
DATABASE_URL="postgresql://card:card@localhost:5432/card?schema=public"

# Прямое подключение для Prisma CLI (migrate deploy / seed).
# На Neon — DIRECT endpoint без пулера. Локально совпадает с DATABASE_URL.
# В рантайме приложения не используется, поэтому опционален.
DIRECT_URL="postgresql://card:card@localhost:5432/card?schema=public"

# Порт HTTP-сервера.
PORT=3000

# development | test | production
NODE_ENV=development
