{
  "name": "digital-business-card",
  "version": "1.0.0",
  "description": "GraphQL backend business card — profile, skills, experience, projects",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "nest build && tsc -p tsconfig.seed.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,api,prisma,scripts,test}/**/*.ts\" prisma.config.ts",
    "format": "prettier --write \"{src,api,prisma,scripts,test}/**/*.ts\" prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "node dist/seed/prisma/seed.js",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run db:seed && nest build",
    "schema:generate": "ts-node -P tsconfig.json scripts/generate-schema.ts",
    "schema:check": "ts-node -P tsconfig.json scripts/generate-schema.ts --check",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/client": "^6.4.1",
    "dataloader": "^2.2.3",
    "graphql": "^16.10.0",
    "prisma": "^6.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
